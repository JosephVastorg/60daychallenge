# ─── Supabase ───────────────────────────────────────────────────────────────
# Project → Settings → API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never import into a client component.
# Used only by trusted server routes (e.g. account deletion, integration token refresh).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for auth redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Strava (Phase 7 — optional) ─────────────────────────────────────────────
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# ─── Garmin (Phase 8 — optional) ─────────────────────────────────────────────
# GARMIN_CONSUMER_KEY=
# GARMIN_CONSUMER_SECRET=
